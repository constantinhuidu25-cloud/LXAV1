{
  "name": "drolly-virtual-reels",
  "version": "2.0.0",
  "description": "DrollyV1 - Virtual Reels Casino Demo (No Real Money)",
  "private": true,
  "main": "game-engine.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js",
    "build": "node scripts/build.js",
    "start": "npx http-server -p 8080",
    "dev": "node local-server.js",
    "bot": "node bot-player.js",
    "security:audit": "npm audit"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "game-engine.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
